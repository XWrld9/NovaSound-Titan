{
  "name": "NovaSound TITAN LUX",
  "short_name": "NovaSound",
  "description": "Plateforme musicale nouvelle génération — découvre, écoute et partage.",
  "start_url": "/#/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "tabbed",
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "note_taking": {
    "new_note_url": "/#/upload"
  },
  "background_color": "#030712",
  "theme_color": "#06b6d4",
  "orientation": "portrait-primary",
  "lang": "fr",
  "dir": "ltr",
  "categories": [
    "music",
    "entertainment"
  ],
  "id": "novasound-titan-lux",
  "prefer_related_applications": false,
  "handle_links": "preferred",
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.novasound.titan",
      "id": "com.novasound.titan"
    },
    {
      "platform": "webapp",
      "url": "https://nova-sound-titan.vercel.app/manifest.json"
    }
  ],
  "file_handlers": [
    {
      "action": "/#/local-player",
      "accept": {
        "audio/mpeg": [
          ".mp3"
        ],
        "audio/wav": [
          ".wav"
        ],
        "audio/ogg": [
          ".ogg"
        ],
        "audio/flac": [
          ".flac"
        ],
        "audio/aac": [
          ".aac"
        ],
        "audio/mp4": [
          ".m4a"
        ],
        "audio/x-m4a": [
          ".m4a"
        ]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+novasound",
      "url": "/#/song?share=%s"
    }
  ],
  "icons": [
    {
      "src": "/favicon.ico",
      "sizes": "48x48",
      "type": "image/x-icon"
    },
    {
      "src": "/favicon.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/notification-badge.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "monochrome"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "NovaSound TITAN LUX — Accueil"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "NovaSound TITAN LUX — Mobile"
    }
  ],
  "shortcuts": [
    {
      "name": "Chat Global",
      "short_name": "Chat",
      "description": "Rejoindre le chat de la communauté",
      "url": "/#/chat",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Explorer",
      "short_name": "Explorer",
      "description": "Découvrir de nouveaux sons",
      "url": "/#/explorer",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Uploader",
      "short_name": "Upload",
      "description": "Publier un nouveau son",
      "url": "/#/upload",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Lecteur Local",
      "short_name": "Local",
      "description": "Lire des fichiers audio locaux (hors-ligne)",
      "url": "/#/local-player",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Live Rooms",
      "short_name": "Live",
      "description": "Rejoindre une salle d'écoute live",
      "url": "/#/live",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/#/upload",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/mpeg",
            "audio/wav",
            "audio/ogg",
            "audio/flac",
            "audio/aac",
            "audio/mp4",
            "audio/x-m4a"
          ]
        }
      ]
    }
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "widgets": [
    {
      "name": "NovaSound Player",
      "short_name": "Player",
      "description": "Contrôle la lecture musicale",
      "tag": "novasound-player",
      "template": "player-widget",
      "ms_ac_template": "/widgets/player.json",
      "data": "/widgets/player-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/icon-512.png",
          "sizes": "512x512",
          "label": "NovaSound Player widget"
        }
      ],
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ],
      "auth": true,
      "update": 86400
    }
  ],
  "version": "25000"
}